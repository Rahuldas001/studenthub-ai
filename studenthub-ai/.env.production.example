# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#
# .env.production is gitignored — fill in every REPLACE value before deploying.
# NEVER reuse the development credentials from backend/.env.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=studenthub_prod
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=studenthub_ai

# Must point at the `postgres` service inside the compose network, not localhost.
DATABASE_URL=postgresql://studenthub_prod:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/studenthub_ai?schema=public

# --- Application --------------------------------------------------------
# Signs session tokens. Rotating it invalidates every signed-in session.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated browser origins allowed to call the API (web frontends).
# Native app builds send no Origin header, so CORS does not gate them.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGIN=

# Host port the API is published on (put nginx/Caddy in front of it for TLS).
API_PORT=4000
