# ---------------------------------------------------------------------------
# StudentHub AI - environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Backend runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://studenthub:studenthub@localhost:5432/studenthub_ai?schema=public"

# Signs student bearer tokens. Keep the local development default for a fresh
# clone; set a long random value in any shared deployment. Rotating it signs
# every active session out.
AUTH_SECRET=studenthub-development-secret-change-me

# Expo: copy to apps/mobile-app/.env, not the root .env.
# Leave unset for offline demo data. Use your computer LAN IP on a physical phone.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Reserved for a later phase - do not put real provider secrets in the client.
# GOOGLE_MAPS_API_KEY=
# CLOUDINARY_URL=
# AI_PROVIDER_API_KEY=