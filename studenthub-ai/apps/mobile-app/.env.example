# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time.
# Never put secrets here - anything prefixed EXPO_PUBLIC_ ships to every user.

# Local development (phone on the same network; use your machine's LAN IP, not localhost).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api

# Production builds read this from the eas.json profile `env` block.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api

# The app has no offline/demo dataset: with no API it shows an explicit error.
