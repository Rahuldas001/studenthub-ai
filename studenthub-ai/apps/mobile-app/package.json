{
  "name": "@studenthub/mobile-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@studenthub/types": "*",
    "expo": "~57.0.26",
    "expo-file-system": "~57.0.7",
    "expo-linear-gradient": "^57.0.2",
    "expo-location": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "export:web": "expo export --platform web --output-dir dist/web",
    "test": "node --test tests/storage.test.cjs tests/auth.test.cjs tests/discovery.test.cjs tests/admin.test.cjs tests/owner.test.cjs",
    "test:storage": "node --test tests/storage.test.cjs",
    "test:owner": "node --test tests/owner.test.cjs",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all --output-dir dist/all",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "config:check": "expo config --type public",
    "eas:whoami": "eas whoami",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform all --profile preview",
    "build:apk": "eas build --platform android --profile preview",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "private": true
}
